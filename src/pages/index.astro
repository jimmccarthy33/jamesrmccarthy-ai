---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackRecordList from '../components/TrackRecordList.astro';
import { getCollection, getEntry } from 'astro:content';
import { site } from '../data/site';
import { trackRecord } from '../data/resume';

const manifesto = await getEntry('writing', site.manifestoSlug);
const published = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = published[0];
const featured = [latest, manifesto].filter(
  (post, index, all): post is NonNullable<typeof post> =>
    !!post && !post.data.draft && all.findIndex((p) => p?.id === post.id) === index,
);
const dateFormat = { year: 'numeric', month: 'long', day: 'numeric' } as const;
---

<BaseLayout description={site.description} path="/">
  <section class="hero">
    <div class="container">
      <div class="home-block hero__stack">
        <h1 class="hero__name">I'm Jim McCarthy.</h1>
        <p class="hero__credential">{site.credential}</p>
        <p class="hero__credential">{site.scope}</p>
        <p class="hero__thesis">{site.thesis}</p>
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="home-section">
        <div class="container">
          <div class="home-block">
          <p class="section-kicker">Writing</p>
          {featured.map((post) => (
            <article class="editorial-row manifesto-row">
              <p class="editorial-row__meta">
                {post.data.pubDate.toLocaleDateString('en-US', dateFormat)}
              </p>
              <h2 class="editorial-row__title">
                <a href={`/writing/${post.id}`}>{post.data.title}</a>
              </h2>
              {post.data.subtitle && (
                <p class="editorial-row__summary">{post.data.subtitle}</p>
              )}
              <p class="editorial-row__summary">{post.data.description}</p>
            </article>
          ))}
          <a class="text-link" href={`/writing/${featured[0].id}`}>
            Read {featured[0].data.title} →
          </a>
          <a class="text-link text-link--secondary" href="/writing">All writing →</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="home-section">
    <div class="container">
      <div class="home-block">
        <p class="section-kicker">Track record</p>
        <TrackRecordList items={trackRecord} />
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container">
      <div class="home-block">
        <p class="section-kicker">About</p>
        <p>
          I am President of Case FMS. Case is a leading provider of exterior facility maintenance
          services across the United States and Canada, with more than 35,000 client locations. I
          am responsible for operational execution, the company's growth, and its proprietary
          technology.
        </p>
        <p>
          I believe AI-native operating models let more people build at startup speed inside incumbent
          organizations. Not less process. More process, running faster, with human judgment on the
          decisions that matter.
        </p>
        <a class="text-link" href="/about">Full bio →</a>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container">
      <div class="home-block">
        <p class="section-kicker">Contact</p>
        <p>{site.contactTeaser}</p>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <a class="text-link" href="/contact">Contact →</a>
      </div>
    </div>
  </section>
</BaseLayout>
