---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrackRecordList from '../components/TrackRecordList.astro';
import { getCollection, getEntry } from 'astro:content';
import { site } from '../data/site';
import { trackRecord } from '../data/resume';

const manifesto = await getEntry('writing', site.manifestoSlug);
const published = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = published[0];
const recent = published.slice(0, 3);
// One featured essay below the hero. The hero already lists the newest posts,
// so this spot is for the piece that best says what the site is about.
const featured = manifesto && !manifesto.data.draft ? manifesto : latest;
const laneLabel = { ai: 'AI', golf: 'Golf', care: 'Care', facilities: 'Facilities' } as const;
const dateFormat = { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' } as const;
const shortDate = { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' } as const;
---

<BaseLayout description={site.description} path="/">
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <figure class="hero__portrait">
          <img
            src="/images/jim-mccarthy-portrait.jpg"
            alt="Jim McCarthy"
            width="600"
            height="800"
          />
        </figure>
        <div class="hero__copy">
          <h1 class="hero__name">
            <span class="hero__name-line">Jim</span>
            <span class="hero__name-line">McCarthy</span>
          </h1>
          <p class="hero__role">{site.heroTitle}</p>
          {
            recent.length > 0 && (
              <nav class="hero__recent" aria-labelledby="hero-recent-label">
                <span class="hero__recent-label" id="hero-recent-label">Recent writing</span>
                <ul class="hero__recent-list">
                  {recent.map((post) => (
                    <li>
                      <a href={`/writing/${post.id}`}>
                        <span>{post.data.title}</span>
                        <time datetime={post.data.pubDate.toISOString()}>
                          {post.data.pubDate.toLocaleDateString('en-US', shortDate)}
                        </time>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="home-section">
        <div class="container">
          <article class="home-block featured-essay">
            <p class="section-kicker">Featured essay</p>
            <p class="featured-essay__meta">
              {featured.data.pubDate.toLocaleDateString('en-US', dateFormat)} · {laneLabel[featured.data.lane]}
            </p>
            <h2 class="featured-essay__title">
              <a href={`/writing/${featured.id}`}>{featured.data.title}</a>
            </h2>
            {featured.data.subtitle && (
              <p class="featured-essay__subtitle">{featured.data.subtitle}</p>
            )}
            <p class="featured-essay__summary">{featured.data.description}</p>
            <a class="text-link" href={`/writing/${featured.id}`}>Read the essay →</a>
            <a class="text-link text-link--secondary" href="/writing">All writing →</a>
          </article>
        </div>
      </section>
    )
  }

  <section class="home-section">
    <div class="container">
      <div class="home-block">
        <p class="section-kicker">Track record</p>
        <TrackRecordList items={trackRecord} />
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container">
      <div class="home-block">
        <p class="section-kicker">About</p>
        <p>{site.scope}</p>
        <a class="text-link" href="/about">Full bio →</a>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="container">
      <div class="home-block">
        <p class="section-kicker">Contact</p>
        <p>{site.contactTeaser}</p>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <a class="text-link" href="/contact">Contact →</a>
      </div>
    </div>
  </section>
</BaseLayout>
