---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (
  await getCollection('writing', ({ data }) => !data.draft && data.series === 'leadership')
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const dateFormat = { year: 'numeric', month: 'long', day: 'numeric' } as const;
---

<BaseLayout
  title="Leadership"
  description="Leadership stories from the work, starting with Korea in 1994."
  path="/leadership"
>
  <header class="page-header">
    <div class="container container--prose">
      <h1>Leadership</h1>
      <p class="page-header__subtitle">
        These are leadership stories from the work, starting with Korea in 1994.
      </p>
    </div>
  </header>

  <section class="page-section">
    <div class="container container--prose">
      {
        posts.map((post) => (
          <article class="editorial-row">
            <p class="editorial-row__meta">
              {post.data.pubDate.toLocaleDateString('en-US', dateFormat)}
            </p>
            <h2 class="editorial-row__title">
              <a href={`/writing/${post.id}`}>{post.data.title}</a>
            </h2>
            {post.data.subtitle && <p class="editorial-row__summary">{post.data.subtitle}</p>}
            <p class="editorial-row__summary">{post.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
