---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutVentures } from '../data/about';
import { site } from '../data/site';
import { resume } from '../data/resume';
---

<BaseLayout
  title="About"
  description={site.description}
  path="/about"
>
  <header class="page-header">
    <div class="container container--narrow">
      <h1>About</h1>
    </div>
  </header>

  <section class="page-section">
    <div class="container container--narrow">
      <div class="about-intro">
        <figure class="about-portrait">
          <img
            src="/images/jim-mccarthy-portrait.jpg"
            alt="Jim McCarthy"
            width="655"
            height="1024"
            loading="eager"
          />
        </figure>
        <p>I'm Jim McCarthy. {site.credential}</p>
        <p>{site.casePractice}</p>
        <p>
          Before that, I ran a $495M P&L on a $600M+ facilities platform. Over two decades I have
          scaled complex, service-based businesses in private-equity-backed and public-company
          environments, from M&A integration and five-nines infrastructure to public-company
          turnaround and AI-native operating systems shipped in months, not years.
        </p>
      </div>
    </div>

    <div class="container container--narrow prose">
      <section class="about-ventures" aria-labelledby="about-ventures-heading">
        <h2 id="about-ventures-heading" class="about-ventures__heading">Building beyond operations</h2>
        {
          aboutVentures.map((venture) => (
            <div class="about-venture">
              <h3>
                {venture.name}
                {venture.role && <span class="about-venture__meta"> · {venture.role}</span>}
              </h3>
              {venture.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          ))
        }
      </section>
    </div>

    <div class="container container--narrow prose">
      <section class="about-experience" aria-labelledby="about-experience-heading">
        <h2 id="about-experience-heading" class="about-experience__heading">Experience</h2>
        {
          resume.roles.map((role) => (
            <div class="role-block">
              <h3>
                {role.company}
                {(role.title || role.period) && (
                  <span class="role-block__meta">
                    {role.title && ` · ${role.title}`}
                    {role.period && ` · ${role.period}`}
                  </span>
                )}
              </h3>
              {
                role.bullets.length > 0 && (
                  <ul>
                    {role.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )
              }
            </div>
          ))
        }

        <p class="about-education">{resume.education}</p>
      </section>
    </div>

    <div class="container container--narrow">
      <p class="about-credential">{site.role}</p>
    </div>
  </section>
</BaseLayout>
