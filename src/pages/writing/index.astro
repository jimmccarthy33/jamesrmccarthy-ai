---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
import { seriesLabel } from '../../data/series';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const laneLabel = {
  ai: 'AI',
  golf: 'Golf',
  care: 'Care',
  facilities: 'Facilities',
} as const;
---

<BaseLayout
  title="Writing"
  description={`Writing by ${site.legalName} (${site.name}) on the work, the tools, golf, care at home, facilities, and leadership.`}
  path="/writing"
>
  <header class="page-header">
    <div class="container container--prose">
      <h1>Writing</h1>
      <p class="page-header__subtitle">
        The work, the tools, golf, care at home, facilities, and leadership.
      </p>
    </div>
  </header>

  <section class="page-section">
    <div class="container container--prose">
      {
        posts.map((post) => (
          <article class="editorial-row">
            <p class="editorial-row__meta">
              {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
              {' · '}
              {laneLabel[post.data.lane]}
              {seriesLabel(post.data.series) && (
                <>
                  {' · '}
                  {post.data.series === 'leadership' ? (
                    <a href="/leadership">{seriesLabel(post.data.series)}</a>
                  ) : (
                    seriesLabel(post.data.series)
                  )}
                </>
              )}
            </p>
            <h2 class="editorial-row__title">
              <a href={`/writing/${post.id}`}>{post.data.title}</a>
            </h2>
            {post.data.subtitle && <p class="editorial-row__summary">{post.data.subtitle}</p>}
            <p class="editorial-row__summary">{post.data.description}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
